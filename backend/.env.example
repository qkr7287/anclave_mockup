# 복사해서 .env 로 쓰고 실제 값 채우기:  cp .env.example .env
# .env 는 절대 git 에 커밋하지 않는다 (.gitignore). 시크릿은 이 머신에만.

# --- Postgres (docker-compose 가 읽음) ---
POSTGRES_USER=anclave
POSTGRES_PASSWORD=change_me           # 실제 비밀번호로 교체 (로컬은 아무거나, 63번은 강한 값)
POSTGRES_DB=anclave
DB_PORT=5432

# --- seed 스크립트 / backend 가 DB 에 붙을 때 ---
DATABASE_URL=postgres://anclave:change_me@localhost:5432/anclave

# --- (다음 단계) Hono backend ---
# PORT=8787
